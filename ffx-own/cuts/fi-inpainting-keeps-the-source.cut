file framegeneration/fsr3/internal/shaders/ffx_frameinterpolation_inpainting_pass.hlsl
--- old
#define FFX_FRAMEINTERPOLATION_BIND_UAV_INPAINTING_MASK                         1
--- new
#define FFX_FRAMEINTERPOLATION_BIND_UAV_INPAINTING_MASK                         1
// (the mod's cut fi-inpainting-keeps-the-source)
#define FFX_FRAMEINTERPOLATION_BIND_UAV_PREVIOUS_INTERPOLATION_SOURCE           2
--- end
file framegeneration/fsr3/internal/shaders/ffx_frameinterpolation_inpainting_pass.hlsl
--- old
    // (the mod's cut fi-inpainting-by-blocks) with a HUD-less image attached or a debug drawing asked for, AMD's function
--- new
    // (the mod's cut fi-inpainting-keeps-the-source) where the dispatch says so (a HUD-less image of 16-bit floats, no debug
    // drawing: bit 30 of the dispatch flags, set by ffx_frameinterpolation.cpp and by nothing else): the HUD-less pixel
    // is stored for the next pair, which AMD's copy at the dispatch's end did, and AMD's function is called only for
    // a pixel it can change: one whose weight asks for inpainting or where the two pictures differ
    if ((GetDispatchFlags() & 0x40000000u) != 0)
    {
        const FfxFloat32x4 fSource = r_current_interpolation_source[iPxPos];
        rw_previous_interpolation_source[iPxPos] = fSource;
        if (rw_inpainting_mask[iPxPos] > FFX_FRAMEINTERPOLATION_EPSILON
            || any(FFX_GREATER_THAN(abs(fSource.rgb - LoadPresentBackbuffer(iPxPos).rgb), FfxFloat32x3(0.0, 0.0, 0.0))))
        {
            computeInpainting(iPxPos);
        }
        return;
    }
    // (the mod's cut fi-inpainting-by-blocks) with a HUD-less image attached or a debug drawing asked for, AMD's function
--- end
file framegeneration/fsr3/internal/ffx_frameinterpolation.cpp
--- old
    {FFX_FRAMEINTERPOLATION_RESOURCE_IDENTIFIER_INPAINTING_MASK,                            L"rw_inpainting_mask"},
--- new
    {FFX_FRAMEINTERPOLATION_RESOURCE_IDENTIFIER_INPAINTING_MASK,                            L"rw_inpainting_mask"},
    // (the mod's cut fi-inpainting-keeps-the-source)
    {FFX_FRAMEINTERPOLATION_RESOURCE_IDENTIFIER_PREVIOUS_INTERPOLATION_SOURCE,              L"rw_previous_interpolation_source"},
--- end
file framegeneration/fsr3/internal/ffx_frameinterpolation.cpp
--- old
    contextPrivate->constants.dispatchFlags         = params->flags;
--- new
    contextPrivate->constants.dispatchFlags         = params->flags;
    // (the mod's cut fi-inpainting-keeps-the-source) with a HUD-less image of 16-bit floats and no debug drawing the inpainting
    // pass stores the HUD-less picture for the next pair, pixel by pixel, and the copy at this dispatch's end is not
    // scheduled. The pass is told by bit 30 of the dispatch flags (AMD's flags are bits 0 to 3; its shaders test bits).
    const bool inpaintingKeepsSource = contextPrivate->constants.HUDLessAttachedFactor == 1
        && (params->flags & (FFX_FRAMEINTERPOLATION_DISPATCH_DRAW_DEBUG_TEAR_LINES | FFX_FRAMEINTERPOLATION_DISPATCH_DRAW_DEBUG_RESET_INDICATORS | FFX_FRAMEINTERPOLATION_DISPATCH_DRAW_DEBUG_VIEW)) == 0
        && contextPrivate->contextDescription.previousInterpolationSourceFormat == FFX_API_SURFACE_FORMAT_R16G16B16A16_FLOAT
        && params->currentBackBuffer_HUDLess.description.format == FFX_API_SURFACE_FORMAT_R16G16B16A16_FLOAT;
    if (inpaintingKeepsSource)
    {
        contextPrivate->constants.dispatchFlags |= 0x40000000u;
    }
--- end
