file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation_setup.h
--- old
    StoreOpticalflowMotionVectorFieldX(iPxPos, 0);
    StoreOpticalflowMotionVectorFieldY(iPxPos, 0);

    StoreDisocclusionMask(iPxPos, FfxFloat32x2(0.0, 0.0));
--- new
    // (the mod's cut fi-setup-zero-what-is-read: optical flow's field is written and read inside optical flow's size
    // alone; the disocclusion mask is rewritten whole before its one reader in every dispatch that is not a reset)
    if (IsOnScreen(iPxPos, GetOpticalFlowSize2()))
    {
        StoreOpticalflowMotionVectorFieldX(iPxPos, 0);
        StoreOpticalflowMotionVectorFieldY(iPxPos, 0);
    }

    if (Reset())
    {
        StoreDisocclusionMask(iPxPos, FfxFloat32x2(0.0, 0.0));
    }
--- end
