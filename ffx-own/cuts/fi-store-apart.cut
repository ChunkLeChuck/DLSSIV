file framegeneration/fsr3/internal/ffx_frameinterpolation.cpp
--- old
        scheduleDispatch(contextPrivate, &contextPrivate->pipelineFiSetup, 1, 1);
--- new
        // (the mod's cut fi-store-apart) a later dispatch of a pair (AGAIN) leaves the count as the pair's first dispatch kept it; the
        // five images are the clears' above
        if (!countKept)
        {
            scheduleDispatch(contextPrivate, &contextPrivate->pipelineFiSetup, 1, 1);
        }
--- end
