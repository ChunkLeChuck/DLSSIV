file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation.h
--- old
void updateInPaintingWeight(inout FfxFloat32 fInPaintingWeight, FfxFloat32 fFactor)
--- new
// (the variant v-env) EVERYTHING BELOW, TO updateInPaintingWeight: THE TWO SAMPLES ALONG THE GAME'S VECTOR, EACH RELIT FOR THE PLACE IT IS PUT.
// Three numbers a place, each with its upper and its lower envelope: the log brightness, the log of red over
// brightness, the log of blue over brightness.
FFX_STATIC const FfxInt32   ENV_TEXEL         = 2;          // as optical flow's first pass writes the envelopes
FFX_STATIC const FfxFloat32 ENV_SRGB          = 2.2f;
FFX_STATIC const FfxFloat32 ENV_GAIN_MOST     = 2.7726f;    // log 16: the brightness's gain is held within 1/16 and 16
FFX_STATIC const FfxFloat32 ENV_TINT_MOST     = 1.0f;       // a tint's gain is held within 1/e and e
FFX_STATIC const FfxFloat32 ENV_OVER          = 2.0f;       // a relit sample is at most this times the brightest the place has been seen
FFX_STATIC const FfxFloat32 ENV_TRUST         = 0.3f;       // a sample's share is multiplied by exp(-|what it needed| / this)
FFX_STATIC const FfxFloat32 ENV_GATE_WIDTH    = 0.05f;      // this is added to the gap between a place's two envelopes
FFX_STATIC const FfxFloat32 ENV_GATE_0        = 0.4f;       // nothing where a gain is under this times that
FFX_STATIC const FfxFloat32 ENV_GATE_1        = 0.8f;       // whole from this times that on
FFX_STATIC const FfxFloat32 ENV_APART_0       = 0.0f;       // (mend 1) nothing where the two places' bands lie less than this apart
FFX_STATIC const FfxFloat32 ENV_APART_1       = 0.25f;      // whole from this on
FFX_STATIC const FfxFloat32 ENV_FRAME_0       = 3.0f;       // nothing in this many frames after a reset
FFX_STATIC const FfxFloat32 ENV_FRAME_1       = 7.0f;       // whole from this many frames after it on
FFX_STATIC const FfxFloat32 ENV_MOVED_0       = 0.5f;       // (mend 2) nothing where the half vector is shorter than this, in pixels of the display
FFX_STATIC const FfxFloat32 ENV_MOVED_1       = 2.0f;       // whole from this on
FFX_STATIC const FfxFloat32 ENV_LEAST         = 0.02f;      // the tint is fetched where a sample's brightness is believed more than this

// one number of one sample: how far its gain is believed (0 to 1), and the gain it needs (log), from the two
// envelopes (x the upper one, y the lower one) at the place it is put and at the place it was fetched. The gain is the
// smaller of the two envelopes' differences where they agree in sign, and none where they do not. THE DEAD BAND IS NOT
// ONE NUMBER: a gain is believed only as far as it stands out of what the two places have themselves been seen to
// vary by, the gap between their two envelopes (the larger of the two gaps, and ENV_GATE_WIDTH more).
FfxFloat32 envOne(FfxFloat32x2 fPlace, FfxFloat32x2 fFetch, FfxFloat32 fMost, out FfxFloat32 fNeeded)
{
    const FfxFloat32x2 fBy = fPlace - fFetch;
    fNeeded = 0.0f;
    if (fBy.x * fBy.y > 0.0f)
    {
        fNeeded = clamp(abs(fBy.x) < abs(fBy.y) ? fBy.x : fBy.y, -fMost, fMost);
    }
    const FfxFloat32 fGap = ffxMax(ffxMax(fPlace.x - fPlace.y, fFetch.x - fFetch.y), 0.0f);
    FfxFloat32 fBelieved = smoothstep(ENV_GATE_0, ENV_GATE_1, abs(fNeeded) / (fGap + ENV_GATE_WIDTH));
    // (MEND 1, THE BANDS APART) a gain is also believed where everything the place has been seen to hold lies on one side of
    // everything the fetch place has: the place's own band may then be as wide as it likes (the car's outline that
    // stood over it some frames ago is still in one envelope) and the two places still do not hold the same light
    fBelieved = ffxMax(fBelieved, smoothstep(ENV_APART_0, ENV_APART_1, ffxMax(fPlace.y - fFetch.x, fFetch.y - fPlace.x)));
    return fBelieved;
}

// what a sample's red, green and blue are multiplied by, for its three gains (log): the brightness's on all three, the
// tints' on red and on blue, and on green what keeps a grey's brightness
FfxFloat32x3 envGain(FfxFloat32x3 fGain)
{
    return exp(FfxFloat32x3(fGain.x + fGain.y, fGain.x - (0.2126f * fGain.y + 0.0722f * fGain.z) / 0.7152f, fGain.x + fGain.z));
}

// THE PIXEL: true where a sample was relit; then fEnvT is the current frame's share by the two samples' trust and
// fEnvShare how far the pixel takes it. False: nothing was touched, and the pixel is the product's.
FfxBoolean envRelight(FfxFloat32x2 fUv, FfxFloat32x2 fHalfUv, inout FfxFloat32x3 fPrevRaw, inout FfxFloat32x3 fCurrRaw, out FfxFloat32 fEnvT, out FfxFloat32 fEnvShare)
{
    fEnvT     = 0.5f;
    fEnvShare = 0.0f;

    const FfxFloat32x2 fSize  = FfxFloat32x2(DisplaySize());
    const FfxFloat32x2 fHalf  = fHalfUv * fSize;
    FfxFloat32 fGrown = ffxSaturate((FfxFloat32(FrameIndexSinceLastReset()) - ENV_FRAME_0) / (ENV_FRAME_1 - ENV_FRAME_0));
    // (MEND 2, NOTHING FOR A SAMPLE THAT HARDLY MOVES) a thing that stands nearly still on the screen (the car itself, a far hill)
    // carries its own edges and its own shading with it, and the envelopes' slope across such an edge is not a light
    // it moves through. Nothing under a half vector of ENV_MOVED_0 pixels of the display, whole from ENV_MOVED_1 on
    fGrown *= smoothstep(ENV_MOVED_0 * ENV_MOVED_0, ENV_MOVED_1 * ENV_MOVED_1, dot(fHalf, fHalf));
    // (nothing in the frames after a reset; nothing where the vector is zero: the fetch place is the place)
    if (fGrown <= 0.0f || (fHalfUv.x == 0.0f && fHalfUv.y == 0.0f))
    {
        return false;
    }

    // the images hold a texel for ENV_TEXEL pixels (the tint's for twice that), rounded up: their own UV of a display UV
    const FfxFloat32x4 fScale = FfxFloat32x4(fSize / FfxFloat32x2(((DisplaySize() + (ENV_TEXEL - 1)) / ENV_TEXEL) * ENV_TEXEL), fSize / FfxFloat32x2(((DisplaySize() + (2 * ENV_TEXEL - 1)) / (2 * ENV_TEXEL)) * (2 * ENV_TEXEL)));

    // the brightness: at the place, and at the two samples' fetch places
    FfxFloat32x3 fNeedPrev;
    FfxFloat32x3 fNeedCurr;
    FfxFloat32x3 fBelievedPrev;
    FfxFloat32x3 fBelievedCurr;
    const FfxFloat32x2 fLogPlace = SampleEnvCurrent(fUv * fScale.xy);
    fBelievedPrev.x = envOne(fLogPlace, SampleEnvCurrent((fUv + fHalfUv) * fScale.xy), ENV_GAIN_MOST, fNeedPrev.x);
    fBelievedCurr.x = envOne(fLogPlace, SampleEnvCurrent((fUv - fHalfUv) * fScale.xy), ENV_GAIN_MOST, fNeedCurr.x);
    // THE TINT RIDES ON THE BRIGHTNESS: where neither sample's brightness is relit the tint's image is not fetched and the
    // pixel is the product's (a difference of colour alone, with no difference of brightness to carry it, is left)
    if (ffxMax(fBelievedPrev.x, fBelievedCurr.x) <= ENV_LEAST)
    {
        return false;
    }

    // the tint (x and y: red over brightness; z and w: blue over brightness)
    const FfxFloat32x4 fTintPlace = SampleEnvTintCurrent(fUv * fScale.zw);
    const FfxFloat32x4 fTintPrev  = SampleEnvTintCurrent((fUv + fHalfUv) * fScale.zw);
    const FfxFloat32x4 fTintCurr  = SampleEnvTintCurrent((fUv - fHalfUv) * fScale.zw);
    fBelievedPrev.y = envOne(fTintPlace.xy, fTintPrev.xy, ENV_TINT_MOST, fNeedPrev.y);
    fBelievedPrev.z = envOne(fTintPlace.zw, fTintPrev.zw, ENV_TINT_MOST, fNeedPrev.z);
    fBelievedCurr.y = envOne(fTintPlace.xy, fTintCurr.xy, ENV_TINT_MOST, fNeedCurr.y);
    fBelievedCurr.z = envOne(fTintPlace.zw, fTintCurr.zw, ENV_TINT_MOST, fNeedCurr.z);

    fBelievedPrev *= fGrown;
    fBelievedCurr *= fGrown;
    const FfxFloat32x3 fMost = ffxMax(fBelievedPrev, fBelievedCurr);
    fEnvShare = ffxMax(fMost.x, ffxMax(fMost.y, fMost.z));
    if (fEnvShare <= 0.0f)
    {
        return false;
    }

    const FfxFloat32   fPower   = BackBufferTransferFunction() == 0 ? 1.0f / ENV_SRGB : 1.0f;
    const FfxFloat32x2 fWasLuma = FfxFloat32x2(RGBToLuma(fPrevRaw), RGBToLuma(fCurrRaw));
    fPrevRaw *= envGain(fNeedPrev * fBelievedPrev * fPower);
    fCurrRaw *= envGain(fNeedCurr * fBelievedCurr * fPower);
    // NO FLARE: a relit sample is never brighter than ENV_OVER times the brightest the place itself has been seen (its upper
    // envelope), unless it was so before: a bright speck of the ground, put on a place that is far brighter than the
    // ground (the game's own interface, where no HUD-less image is bound), does not come out many times as bright
    const FfxFloat32 fOver = ENV_OVER * exp(fLogPlace.x * fPower);
    fPrevRaw *= ffxMin(1.0f, ffxMax(fWasLuma.x, fOver) / ffxMax(RGBToLuma(fPrevRaw), 1.0e-6f));
    fCurrRaw *= ffxMin(1.0f, ffxMax(fWasLuma.y, fOver) / ffxMax(RGBToLuma(fCurrRaw), 1.0e-6f));

    const FfxFloat32 fTrustPrev = exp(-(abs(fNeedPrev.x) + abs(fNeedPrev.y) + abs(fNeedPrev.z)) / ENV_TRUST);
    const FfxFloat32 fTrustCurr = exp(-(abs(fNeedCurr.x) + abs(fNeedCurr.y) + abs(fNeedCurr.z)) / ENV_TRUST);
    fEnvT = fTrustCurr / (fTrustPrev + fTrustCurr);
    return true;
}

void updateInPaintingWeight(inout FfxFloat32 fInPaintingWeight, FfxFloat32 fFactor)
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation.h
--- old
    // (the mod's cut fi-interpolation-same-vector-once: the same function of the same arguments is not computed twice)
--- new
    // (the variant v-env) the two samples along the game's vector, each relit for the place it is put; where nothing is
    // believed nothing is touched
    FfxFloat32 fEnvT     = 0.5f;
    FfxFloat32 fEnvShare = 0.0f;
    const FfxBoolean bEnv = envRelight(fUvInScreenSpace, gameMv.fMotionVector * fUvLetterBoxScale, fPrevColorGame.fRaw, fCurrColorGame.fRaw, fEnvT, fEnvShare);

    // (the mod's cut fi-interpolation-same-vector-once: the same function of the same arguments is not computed twice)
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation.h
--- old
        fInterpolatedColor = ffxLerp(fPrevColorGame.fRaw, fCurrColorGame.fRaw, ffxSaturate(t));
--- new
        // (the variant v-env) where both samples are used and the pixel is relit, the one that needed the least relighting is believed
        if (bEnv && fDisocclusionFactor.x > 0.0f && fDisocclusionFactor.y > 0.0f)
        {
            t = ffxLerp(t, fEnvT, fEnvShare);
        }
        fInterpolatedColor = ffxLerp(fPrevColorGame.fRaw, fCurrColorGame.fRaw, ffxSaturate(t));
--- end
