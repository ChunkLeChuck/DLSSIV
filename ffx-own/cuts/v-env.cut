--- new
    // (the variant v-env) the four images of the envelopes: the frame before's two are read by the first pass, this frame's two written
    context->contextDescription.backendInterface.fpRegisterResource(&context->contextDescription.backendInterface, &params->envPrevious, context->effectContextId, &context->srvBindings[FFX_OF_BINDING_IDENTIFIER_ENV_PREVIOUS]);
    context->contextDescription.backendInterface.fpRegisterResource(&context->contextDescription.backendInterface, &params->envTintPrevious, context->effectContextId, &context->srvBindings[FFX_OF_BINDING_IDENTIFIER_ENV_TINT_PREVIOUS]);
    context->contextDescription.backendInterface.fpRegisterResource(&context->contextDescription.backendInterface, &params->envCurrent, context->effectContextId, &context->uavBindings[FFX_OF_BINDING_IDENTIFIER_ENV_CURRENT]);
    context->contextDescription.backendInterface.fpRegisterResource(&context->contextDescription.backendInterface, &params->envTintCurrent, context->effectContextId, &context->uavBindings[FFX_OF_BINDING_IDENTIFIER_ENV_TINT_CURRENT]);

    FfxCommandList commandList = params->commandList;
    int advancedAlgorithmIterations = 7;
--- end
file framegeneration/fsr3/internal/ffx_opticalflow.cpp
--- old
    context->constants.backbufferTransferFunction = params->backbufferTransferFunction;
--- new
    context->constants.backbufferTransferFunction = params->backbufferTransferFunction;
    // (the variant v-env) the envelopes' step follows the frame's time
    {
        const float envRate = params->envFrameTimeMs * (1.0f / 16.667f);
        context->constants.envRate = envRate < 0.25f ? 0.25f : envRate > 4.0f ? 4.0f : envRate;
    }
--- end
