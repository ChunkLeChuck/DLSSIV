    {FFX_OF_BINDING_IDENTIFIER_ENV_TINT_CURRENT,                        L"rw_env_tint_current"},
--- end
file framegeneration/fsr3/internal/ffx_opticalflow.cpp
--- old
    FfxCommandList commandList = params->commandList;
