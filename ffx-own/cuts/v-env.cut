file framegeneration/fsr3/internal/shaders/ffx_opticalflow_prepare_luma_pass.hlsl
--- old
#define FFX_OPTICALFLOW_BIND_SRV_INPUT_COLOR           0
--- new
#define FFX_OPTICALFLOW_BIND_SRV_INPUT_COLOR           0
// (the variant v-env) the envelopes the pair before wrote, and this pair's
#define FFX_OPTICALFLOW_BIND_SRV_ENV_PREVIOUS          1
#define FFX_OPTICALFLOW_BIND_SRV_ENV_TINT_PREVIOUS     2
#define FFX_OPTICALFLOW_BIND_UAV_ENV_CURRENT           1
#define FFX_OPTICALFLOW_BIND_UAV_ENV_TINT_CURRENT      2
--- end
file framegeneration/fsr3/include/gpu/opticalflow/ffx_opticalflow_prepare_luma.h
--- old
void PrepareLuma(FfxInt32x2 iGlobalId, FfxInt32 iLocalIndex)
{
#define PixelsPerThreadX 2
#define PixelsPerThreadY 2
--- new
// (the variant v-env) THE TWO ENVELOPES OF THE CURRENT REAL FRAME, one texel of the brightness a thread: this pass has a thread for
// two by two pixels of the picture and loads the four colours for its own work; their mean is the texel. A texel of
// the tint is the mean of two by two of those, written by the thread of its first one. Every value is held within a
// floor and a ceiling, so that no log of nothing and no infinity ever enters an image. Each envelope sinks or rises
// towards the frame by ENV_STEP a real frame of 16.7 ms, or by ENV_SHARE of what is left where that is less.
FFX_STATIC const FfxFloat32 ENV_STEP       = 0.25f;
FFX_STATIC const FfxFloat32 ENV_SHARE      = 0.3f;
FFX_STATIC const FfxFloat32 ENV_SHARE_MOST = 0.9f;      // (a share of 1 is the plain step: all that is left where that is less)
FFX_STATIC const FfxFloat32 ENV_FLOOR      = 1.0e-5f;
FFX_STATIC const FfxFloat32 ENV_CEILING    = 6.0e4f;
FFX_STATIC const FfxFloat32 ENV_TINT_FLOOR = 1.0e-3f;   // added to both sides of a tint's ratio: in the dark there is no tint
FFX_STATIC const FfxFloat32 ENV_SRGB       = 2.2f;      // an sRGB picture's brightness is its raw value to this power, about
FFX_STATIC const FfxInt32   ENV_CREEP       = 2;        // (mend 3) how many texels away an envelope looks at its neighbours
FFX_STATIC const FfxFloat32 ENV_CREEP_SLACK = 0.3f;      // and how far above (below) theirs it may stay

// an envelope a step nearer the frame: bUpper the upper one (it sinks), else the lower one (it rises)
FfxFloat32 envStep(FfxFloat32 fNow, FfxFloat32 fBefore, FfxFloat32 fStep, FfxFloat32 fShare, FfxBoolean bUpper)
{
    if (bUpper)
    {
        return ffxMax(fNow, fBefore - ffxMin(fStep, fShare * (fBefore - fNow)));
    }
    return ffxMin(fNow, fBefore + ffxMin(fStep, fShare * (fNow - fBefore)));
}

FfxFloat32 envLuma(FfxFloat32x3 fColour)
{
    return 0.2126f * fColour.x + 0.7152f * fColour.y + 0.0722f * fColour.z;
}

// the mean colour of the two by two pixels of another thread's texel (at the picture's edge: the last texel's, the last pixel's)
FfxFloat32x3 envTexel(FfxInt32x2 iTexel, FfxInt32x2 iSize)
{
    const FfxInt32x2 iPx   = min(iTexel, iSize - 1) * 2;
    const FfxInt32x2 iLast = iInputLumaResolution - 1;
    return (LoadInputColor(min(iPx, iLast)).rgb + LoadInputColor(min(iPx + FfxInt32x2(1, 0), iLast)).rgb + LoadInputColor(min(iPx + FfxInt32x2(0, 1), iLast)).rgb + LoadInputColor(min(iPx + FfxInt32x2(1, 1), iLast)).rgb) * 0.25f;
}

// fColour: the mean colour of the thread's own pixels
void envOfThread(FfxInt32x2 iTexel, FfxFloat32x3 fColour)
{
    const FfxInt32x2 iSize = (iInputLumaResolution + 1) / 2;
    if (iTexel.x >= iSize.x || iTexel.y >= iSize.y)
    {
        return;
    }

    const FfxFloat32 fStep  = ENV_STEP * fEnvRate;
    const FfxFloat32 fShare = ffxMin(ENV_SHARE * fEnvRate, ENV_SHARE_MOST);
    const FfxFloat32 fPower = BackbufferTransferFunction() == 0 ? ENV_SRGB : 1.0f;
    const FfxBoolean bFirst = FrameIndex() == 0;        // the dispatch of a reset, and the first of all: nothing is taken from the images before

    const FfxFloat32 fLog = log(clamp(envLuma(fColour), ENV_FLOOR, ENV_CEILING)) * fPower;
    FfxFloat32x2 fEnv = FfxFloat32x2(fLog, fLog);
    if (!bFirst)
    {
        const FfxFloat32x2 fBefore = r_env_previous[iTexel];
        fEnv.x = envStep(fLog, fBefore.x, fStep, fShare, true);
        fEnv.y = envStep(fLog, fBefore.y, fStep, fShare, false);

        // (MEND 3, THE ENVELOPES CREEP) A LIGHT THAT STAYS WITH A THING THAT SHIFTS ON THE SCREEN (the car's own shadow as the car drifts a
        // pixel or two a frame) covers new places all the time, and there the upper envelope would take a dozen frames
        // to sink to it. Where the frame lies under the upper envelope, that envelope may not stay more than
        // ENV_CREEP_SLACK above the lowest one ENV_CREEP texels away: what has sunk next door has sunk here. A shadow that
        // streams past with the ground outruns this (its neighbours were lit a frame ago too); one that creeps takes
        // its envelope along. The same for the lower envelope and a pool of light that creeps.
        const FfxInt32x2   iMost = iSize - 1;
        const FfxFloat32x2 fW = r_env_previous[clamp(iTexel + FfxInt32x2(-ENV_CREEP, 0), FfxInt32x2(0, 0), iMost)];
        const FfxFloat32x2 fE = r_env_previous[clamp(iTexel + FfxInt32x2(ENV_CREEP, 0), FfxInt32x2(0, 0), iMost)];
        const FfxFloat32x2 fN = r_env_previous[clamp(iTexel + FfxInt32x2(0, -ENV_CREEP), FfxInt32x2(0, 0), iMost)];
        const FfxFloat32x2 fS = r_env_previous[clamp(iTexel + FfxInt32x2(0, ENV_CREEP), FfxInt32x2(0, 0), iMost)];
        fEnv.x = ffxMax(fLog, ffxMin(fEnv.x, ffxMin(ffxMin(fW.x, fE.x), ffxMin(fN.x, fS.x)) + ENV_CREEP_SLACK));
        fEnv.y = ffxMin(fLog, ffxMax(fEnv.y, ffxMax(ffxMax(fW.y, fE.y), ffxMax(fN.y, fS.y)) - ENV_CREEP_SLACK));
    }
    rw_env_current[iTexel] = fEnv;

    // the tint of two by two texels together, by the thread of the first: log red over brightness, log blue over brightness
    if ((iTexel.x & 1) == 0 && (iTexel.y & 1) == 0)
    {
        FfxFloat32x3 fAll = fColour;
        fAll += envTexel(iTexel + FfxInt32x2(1, 0), iSize);
        fAll += envTexel(iTexel + FfxInt32x2(0, 1), iSize);
        fAll += envTexel(iTexel + FfxInt32x2(1, 1), iSize);
        fAll = clamp(fAll * 0.25f, FfxFloat32x3(0.0f, 0.0f, 0.0f), FfxFloat32x3(ENV_CEILING, ENV_CEILING, ENV_CEILING));

        const FfxInt32x2   iTint  = iTexel / 2;
        const FfxFloat32   fBase2 = log(ffxMax(envLuma(fAll), 0.0f) + ENV_TINT_FLOOR);
        const FfxFloat32x2 fTint  = (log(fAll.xz + ENV_TINT_FLOOR) - fBase2) * fPower;
        FfxFloat32x4 fEnvTint = FfxFloat32x4(fTint.x, fTint.x, fTint.y, fTint.y);
        if (!bFirst)
        {
            const FfxFloat32x4 fBeforeTint = r_env_tint_previous[iTint];
            fEnvTint.x = envStep(fTint.x, fBeforeTint.x, fStep, fShare, true);
            fEnvTint.y = envStep(fTint.x, fBeforeTint.y, fStep, fShare, false);
            fEnvTint.z = envStep(fTint.y, fBeforeTint.z, fStep, fShare, true);
            fEnvTint.w = envStep(fTint.y, fBeforeTint.w, fStep, fShare, false);
        }
        rw_env_tint_current[iTint] = fEnvTint;
    }
}

void PrepareLuma(FfxInt32x2 iGlobalId, FfxInt32 iLocalIndex)
{
#define PixelsPerThreadX 2
#define PixelsPerThreadY 2
    // (the variant v-env) the colours of the thread's pixels together (those that lie in the picture), for its texel of the envelopes
    FfxFloat32x3 fEnvSum   = FfxFloat32x3(0.0f, 0.0f, 0.0f);
    FfxFloat32   fEnvCount = 0.0f;
--- end
file framegeneration/fsr3/include/gpu/opticalflow/ffx_opticalflow_prepare_luma.h
--- old
            FfxFloat32x3 inputColor = LoadInputColor(iPxHrPos).rgb;
--- new
            FfxFloat32x3 inputColor = LoadInputColor(iPxHrPos).rgb;
            // (the variant v-env)
            if (pos.x < iInputLumaResolution.x && pos.y < iInputLumaResolution.y)
            {
                fEnvSum   += inputColor;
                fEnvCount += 1.0f;
            }
--- end
file framegeneration/fsr3/include/gpu/opticalflow/ffx_opticalflow_prepare_luma.h
--- old
