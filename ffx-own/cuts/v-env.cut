        }
    }
}
--- new
            StoreOpticalFlowInput(pos, FfxUInt32(fY * 255));
        }
    }
    // (the variant v-env)
    envOfThread(iGlobalId, fEnvSum / ffxMax(fEnvCount, 1.0f));
}
--- end
