--- old
    FfxFloat32x2 fMotionVectorHalf = fOpticalFlowVector * 0.5f;
--- new
    FfxFloat32x2 fMotionVectorHalf = fOpticalFlowVector * PositionStoredShare();    // (the mod's cut fi-position: AMD's 0.5f; the name stays AMD's)
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation_reconstruct_previous_depth.h
--- old
    ReconstructPrevDepth(iPxPos, 1, fDilatedDepth, fMotionVector * 0.5f, RenderSize());
--- new
    ReconstructPrevDepth(iPxPos, 1, fDilatedDepth, fMotionVector * PositionStoredShare(), RenderSize());    // (the mod's cut fi-position: AMD's 0.5f)
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation_disocclusion_mask.h
--- old
    const FfxFloat32 fDepthClipInterpolatedToPrevious   = 1.0f - ComputeDepthClip(0, fDepthUv + gameMv.fMotionVector, fDilatedDepth);
--- new
    const FfxFloat32 fDepthClipInterpolatedToPrevious   = 1.0f - ComputeDepthClip(0, fDepthUv + gameMv.fMotionVector * PositionToPrevious(), fDilatedDepth);    // (the mod's cut fi-position)
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation_disocclusion_mask.h
--- old
    const FfxFloat32x2 fSrcMotionVector   = gameMv.fMotionVector * 2.0f;
--- new
    const FfxFloat32x2 fSrcMotionVector   = gameMv.fMotionVector * PositionWhole();    // (the mod's cut fi-position: AMD's 2.0f, the whole vector)
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation.h
--- old
    InterpolationSourceColor fPrevColorGame = SampleTextureBilinear(false, fUvInScreenSpace, +gameMv.fMotionVector * fUvLetterBoxScale, DisplaySize()); // Get in previous frame buffer, the color of interpolated pixel
--- new
    InterpolationSourceColor fPrevColorGame = SampleTextureBilinear(false, fUvInScreenSpace, +gameMv.fMotionVector * PositionToPrevious() * fUvLetterBoxScale, DisplaySize()); // Get in previous frame buffer, the color of interpolated pixel (the mod's cut fi-position: toward the previous frame at t)
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation.h
--- old
        fPrevColorOF = SampleTextureBilinear(false, fUvInScreenSpace, +ofMv.fMotionVector * fUvLetterBoxScale, DisplaySize());
--- new
        fPrevColorOF = SampleTextureBilinear(false, fUvInScreenSpace, +ofMv.fMotionVector * PositionToPrevious() * fUvLetterBoxScale, DisplaySize());    // (the mod's cut fi-position)
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation.h
--- old
        FfxFloat32 t = 0.5f;
        t += 0.5f * (1 - (fDisocclusionFactor.x));
        t -= 0.5f * (1 - (fDisocclusionFactor.y));
--- new
        // (the mod's cut fi-position: AMD's blend at 0.5 is the blend at t. One side valid: that side's, 0 or 1, as AMD's;
        // neither: t. Every case at the middle is AMD's value exactly)
        const FfxFloat32 fPosition = InterpolationPosition();
        FfxFloat32 t = fPosition;
        t += (1.0f - fPosition) * (1 - (fDisocclusionFactor.x)) * fDisocclusionFactor.y;
        t -= fPosition * (1 - (fDisocclusionFactor.y)) * fDisocclusionFactor.x;
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation.h
--- old
        FfxFloat32 ofT = 0.5f;

        if (fPrevColorOF.fBilinearWeightSum > 0 && fCurrColorOF.fBilinearWeightSum > 0)
        {
            ofT = 0.5f;
        }
--- new
        FfxFloat32 ofT = InterpolationPosition();    // (the mod's cut fi-position: AMD's 0.5f, here and below)

        if (fPrevColorOF.fBilinearWeightSum > 0 && fCurrColorOF.fBilinearWeightSum > 0)
        {
            ofT = InterpolationPosition();
        }
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation_common.h
--- old
        vfElement.bInPainted            = true;
    }

    vfElement.bNegOutside = !IsUvInside(fUv - vfElement.fMotionVector);
    vfElement.bPosOutside = !IsUvInside(fUv + vfElement.fMotionVector);
--- new
        vfElement.bInPainted            = true;
    }

    vfElement.bNegOutside = !IsUvInside(fUv - vfElement.fMotionVector);
    vfElement.bPosOutside = !IsUvInside(fUv + vfElement.fMotionVector * PositionToPrevious());    // (the mod's cut fi-position)
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation_common.h
--- old
        vfElement.uLowPriorityFactor /= fWeightSum;
    }

    vfElement.bNegOutside = !IsUvInside(fUv - vfElement.fMotionVector);
    vfElement.bPosOutside = !IsUvInside(fUv + vfElement.fMotionVector);
--- new
        vfElement.uLowPriorityFactor /= fWeightSum;
    }

    vfElement.bNegOutside = !IsUvInside(fUv - vfElement.fMotionVector);
    vfElement.bPosOutside = !IsUvInside(fUv + vfElement.fMotionVector * PositionToPrevious());    // (the mod's cut fi-position)
--- end
file framegeneration/fsr3/include/ffx_frameinterpolation.h
--- old
    FfxApiResource                         distortionField;                    ///< A resource containing distortion offset data used when distortion post effects are enabled.
} FfxFrameInterpolationDispatchDescription;
--- new
    FfxApiResource                         distortionField;                    ///< A resource containing distortion offset data used when distortion post effects are enabled.

    float                               interpolationPosition;              ///< (the mod's cut fi-position) where the generated frame stands: 0 the previous frame, 1 the current; 0, or anything not inside (0, 1), is AMD's middle (0.5)
} FfxFrameInterpolationDispatchDescription;
--- end
file framegeneration/fsr3/internal/ffx_frameinterpolation.cpp
--- old
    contextPrivate->constants.fTanHalfFOV               = tanf(cameraAngleHorizontal * 0.5f);
--- new
    contextPrivate->constants.fTanHalfFOV               = tanf(cameraAngleHorizontal * 0.5f);
    // (the mod's cut fi-position) where the generated frame stands, into AMD's spare word: the middle unless it is inside (0, 1)
    contextPrivate->constants.fInterpolationPosition    = (params->interpolationPosition > 0.0f && params->interpolationPosition < 1.0f) ? params->interpolationPosition : 0.5f;
--- end
