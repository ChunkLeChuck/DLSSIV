file framegeneration/fsr3/internal/ffx_frameinterpolation.cpp
--- old
    // copy resources to uavResrouces list
--- new
    // (the variant v-env) the four images of the envelopes: the brightness's, one texel for envTexel by envTexel pixels of the
    // display and two channels of 16-bit float; the tint's, one texel for twice that a side and four channels. The
    // disocclusion mask's pass writes the two "current" ones whole in every dispatch that interpolates;
    // ffxFrameInterpolationDispatch makes each pair change places first
    {
        const uint32_t envTexel = 2;    // ENV_TEXEL of the two shader files
        const uint32_t envIds[4] = {FFX_FRAMEINTERPOLATION_RESOURCE_IDENTIFIER_RESERVED_2, FFX_FRAMEINTERPOLATION_RESOURCE_IDENTIFIER_RESERVED_3, FFX_FRAMEINTERPOLATION_RESOURCE_IDENTIFIER_RESERVED_4, FFX_FRAMEINTERPOLATION_RESOURCE_IDENTIFIER_RESERVED_5};
        const wchar_t* envNames[4] = {L"FI_EnvPrevious", L"FI_EnvCurrent", L"FI_EnvTintPrevious", L"FI_EnvTintCurrent"};
        for (int i = 0; i < 4; ++i)
        {
            const uint32_t envSide = i < 2 ? envTexel : 2 * envTexel;
            FfxCreateResourceDescription env = { FfxResourceHeapPlacementInfo::InitDefault(), { FFX_API_RESOURCE_TYPE_TEXTURE2D, i < 2 ? FFX_API_SURFACE_FORMAT_R16G16_FLOAT : FFX_API_SURFACE_FORMAT_R16G16B16A16_FLOAT, (contextDescription->displaySize.width + envSide - 1) / envSide, (contextDescription->displaySize.height + envSide - 1) / envSide, 1, 1, FFX_API_RESOURCE_FLAGS_NONE, FFX_API_RESOURCE_USAGE_UAV }, FFX_API_RESOURCE_STATE_UNORDERED_ACCESS, envNames[i], envIds[i], {FFX_RESOURCE_INIT_DATA_TYPE_UNINITIALIZED} };
            FFX_VALIDATE(context->contextDescription.backendInterface.fpCreateResource(&context->contextDescription.backendInterface, &env, context->effectContextId, &context->srvResources[envIds[i]]));
        }
    }

    // copy resources to uavResrouces list
--- end
