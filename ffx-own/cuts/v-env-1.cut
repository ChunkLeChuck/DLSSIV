file framegeneration/fsr3/internal/ffx_frameinterpolation.cpp
--- old
    uint32_t displayDispatchSizeX = uint32_t(params->displaySize.width + 7) / 8;
--- new
    // (the variant v-env) THE IMAGES OF THE ENVELOPES CHANGE PLACES, each pair: what the dispatch before wrote as the current one
    // is the one before now, and the older one is written anew by this dispatch's disocclusion mask pass. A dispatch
    // told to reset writes none, and the first one after it that does takes nothing from the images before (the pass
    // reads the count of frames since the reset).
    for (int envPair = 0; envPair < 2; ++envPair)
    {
        const uint32_t envBefore = envPair == 0 ? FFX_FRAMEINTERPOLATION_RESOURCE_IDENTIFIER_RESERVED_2 : FFX_FRAMEINTERPOLATION_RESOURCE_IDENTIFIER_RESERVED_4;
        const uint32_t envNow    = envPair == 0 ? FFX_FRAMEINTERPOLATION_RESOURCE_IDENTIFIER_RESERVED_3 : FFX_FRAMEINTERPOLATION_RESOURCE_IDENTIFIER_RESERVED_5;
        const FfxResourceInternal envSwap = contextPrivate->srvResources[envBefore];
        contextPrivate->srvResources[envBefore] = contextPrivate->srvResources[envNow];
        contextPrivate->srvResources[envNow]    = envSwap;
        contextPrivate->uavResources[envBefore] = contextPrivate->srvResources[envBefore];
        contextPrivate->uavResources[envNow]    = contextPrivate->srvResources[envNow];
    }

    uint32_t displayDispatchSizeX = uint32_t(params->displaySize.width + 7) / 8;
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation_disocclusion_mask.h
--- old
void computeDisocclusionMask(FfxInt32x2 iPxPos)
{
--- new
// (the variant v-env) THE TWO ENVELOPES OF THE CURRENT REAL FRAME, one texel of the brightness a thread. A texel of the brightness is the mean of
// ENV_TEXEL by ENV_TEXEL pixels of the display (one filtered tap for two by two of them); a texel of the tint is the
// mean of two by two of those, written by the thread of its first one. Every value is held within a floor and a
// ceiling, so that no log of nothing and no infinity ever enters an image. Each envelope sinks or rises towards the
// frame by ENV_STEP a real frame of 16.7 ms, or by ENV_SHARE of what is left where that is less.
FFX_STATIC const FfxInt32   ENV_TEXEL      = 2;
FFX_STATIC const FfxFloat32 ENV_STEP       = 0.25f;
FFX_STATIC const FfxFloat32 ENV_SHARE      = 0.3f;
FFX_STATIC const FfxFloat32 ENV_SHARE_MOST = 0.9f;      // (a share of 1 is the plain step: all that is left where that is less)
FFX_STATIC const FfxFloat32 ENV_FLOOR      = 1.0e-5f;
FFX_STATIC const FfxFloat32 ENV_CEILING    = 6.0e4f;
FFX_STATIC const FfxFloat32 ENV_TINT_FLOOR = 1.0e-3f;   // added to both sides of a tint's ratio: in the dark there is no tint
FFX_STATIC const FfxFloat32 ENV_SRGB       = 2.2f;      // an sRGB picture's brightness is its raw value to this power, about

// an envelope a step nearer the frame: bUpper the upper one (it sinks), else the lower one (it rises)
FfxFloat32 envStep(FfxFloat32 fNow, FfxFloat32 fBefore, FfxFloat32 fStep, FfxFloat32 fShare, FfxBoolean bUpper)
{
    if (bUpper)
    {
        return ffxMax(fNow, fBefore - ffxMin(fStep, fShare * (fBefore - fNow)));
    }
    return ffxMin(fNow, fBefore + ffxMin(fStep, fShare * (fNow - fBefore)));
}

// the mean colour of the pixels of one texel of the brightness
FfxFloat32x3 envTexel(FfxInt32x2 iTexel)
{
    const FfxInt32     iTaps = ENV_TEXEL / 2;
    const FfxFloat32x2 fBase = FfxFloat32x2(iTexel * ENV_TEXEL);
    const FfxFloat32x2 fRcp  = FfxFloat32x2(1.0f, 1.0f) / FfxFloat32x2(DisplaySize());

    FfxFloat32x3 fSum = FfxFloat32x3(0.0f, 0.0f, 0.0f);
    for (FfxInt32 iTapY = 0; iTapY < iTaps; iTapY++)
    {
        for (FfxInt32 iTapX = 0; iTapX < iTaps; iTapX++)
        {
            fSum += SampleCurrentBackbuffer((fBase + FfxFloat32x2(2 * iTapX + 1, 2 * iTapY + 1)) * fRcp);
        }
    }
    return fSum * (1.0f / FfxFloat32(iTaps * iTaps));
}

void envOfThread(FfxInt32x2 iPxPos)
{
    // a thread writes one texel of the brightness; two by two (or more) where the guides are smaller than the image
    const FfxInt32x2 iSize  = (DisplaySize() + (ENV_TEXEL - 1)) / ENV_TEXEL;
    const FfxInt32x2 iEach2 = (iSize + RenderSize() - 1) / RenderSize();
    const FfxInt32   iEach  = max(1, max(iEach2.x, iEach2.y));
    if (iPxPos.x * iEach >= iSize.x || iPxPos.y * iEach >= iSize.y)
    {
        return;
    }

    const FfxFloat32 fRate  = clamp(deltaTime * (1.0f / 16.667f), 0.25f, 4.0f);
    const FfxFloat32 fStep  = ENV_STEP * fRate;
    const FfxFloat32 fShare = ffxMin(ENV_SHARE * fRate, ENV_SHARE_MOST);
    const FfxFloat32 fPower = BackBufferTransferFunction() == 0 ? ENV_SRGB : 1.0f;
    const FfxBoolean bFirst = FrameIndexSinceLastReset() <= 1;

    for (FfxInt32 iY = 0; iY < iEach; iY++)
    {
        for (FfxInt32 iX = 0; iX < iEach; iX++)
        {
            const FfxInt32x2   iTexel = iPxPos * iEach + FfxInt32x2(iX, iY);
            const FfxFloat32x3 fSum   = envTexel(iTexel);

            const FfxFloat32 fLog = log(clamp(RGBToLuma(fSum), ENV_FLOOR, ENV_CEILING)) * fPower;
            FfxFloat32x2 fEnv = FfxFloat32x2(fLog, fLog);
            if (!bFirst)
            {
                const FfxFloat32x2 fBefore = LoadEnvPrevious(iTexel);
                fEnv.x = envStep(fLog, fBefore.x, fStep, fShare, true);
                fEnv.y = envStep(fLog, fBefore.y, fStep, fShare, false);
            }
            StoreEnvCurrent(iTexel, fEnv);

            // the tint of two by two texels together, by the thread of the first: log red over brightness, log blue over brightness
            if ((iTexel.x & 1) == 0 && (iTexel.y & 1) == 0)
            {
                FfxFloat32x3 fAll = fSum;
                fAll += envTexel(iTexel + FfxInt32x2(1, 0));
                fAll += envTexel(iTexel + FfxInt32x2(0, 1));
                fAll += envTexel(iTexel + FfxInt32x2(1, 1));
                fAll = clamp(fAll * 0.25f, FfxFloat32x3(0.0f, 0.0f, 0.0f), FfxFloat32x3(ENV_CEILING, ENV_CEILING, ENV_CEILING));

                const FfxInt32x2   iTint  = iTexel / 2;
                const FfxFloat32   fBase2 = log(ffxMax(RGBToLuma(fAll), 0.0f) + ENV_TINT_FLOOR);
                const FfxFloat32x2 fTint  = (log(fAll.xz + ENV_TINT_FLOOR) - fBase2) * fPower;
                FfxFloat32x4 fEnvTint = FfxFloat32x4(fTint.x, fTint.x, fTint.y, fTint.y);
                if (!bFirst)
                {
                    const FfxFloat32x4 fBeforeTint = LoadEnvTintPrevious(iTint);
                    fEnvTint.x = envStep(fTint.x, fBeforeTint.x, fStep, fShare, true);
                    fEnvTint.y = envStep(fTint.x, fBeforeTint.y, fStep, fShare, false);
                    fEnvTint.z = envStep(fTint.y, fBeforeTint.z, fStep, fShare, true);
                    fEnvTint.w = envStep(fTint.y, fBeforeTint.w, fStep, fShare, false);
                }
                StoreEnvTintCurrent(iTint, fEnvTint);
            }
        }
    }
}

void computeDisocclusionMask(FfxInt32x2 iPxPos)
{
    // (the variant v-env)
    envOfThread(iPxPos);

--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation.h
--- old
void updateInPaintingWeight(inout FfxFloat32 fInPaintingWeight, FfxFloat32 fFactor)
--- new
// (the variant v-env) EVERYTHING BELOW, TO updateInPaintingWeight: THE TWO SAMPLES ALONG THE GAME'S VECTOR, EACH RELIT FOR THE PLACE IT IS PUT.
// Three numbers a place, each with its upper and its lower envelope: x the log brightness, y the log of red over
// brightness, z the log of blue over brightness.
FFX_STATIC const FfxInt32   ENV_TEXEL         = 2;          // as the disocclusion mask's pass writes the envelopes
FFX_STATIC const FfxFloat32 ENV_SRGB          = 2.2f;
FFX_STATIC const FfxFloat32 ENV_GAIN_MOST     = 2.7726f;    // log 16: the brightness's gain is held within 1/16 and 16
FFX_STATIC const FfxFloat32 ENV_TINT_MOST     = 1.0f;       // a tint's gain is held within 1/e and e
FFX_STATIC const FfxFloat32 ENV_TRUST         = 0.3f;       // a sample's share is multiplied by exp(-|what it needed| / this)
FFX_STATIC const FfxFloat32 ENV_GATE_BY_WIDTH = 1.0f;       // the gap between a place's two envelopes counts this much
FFX_STATIC const FfxFloat32 ENV_GATE_WIDTH    = 0.05f;      // and this is added to it
FFX_STATIC const FfxFloat32 ENV_GATE_0        = 0.4f;       // nothing where a gain is under this times that
FFX_STATIC const FfxFloat32 ENV_GATE_1        = 0.8f;       // whole from this times that on
FFX_STATIC const FfxFloat32 ENV_FRAME_0       = 3.0f;       // nothing in this many frames after a reset
FFX_STATIC const FfxFloat32 ENV_FRAME_1       = 7.0f;       // whole from this many frames after it on

// the two envelopes at a place of the picture (a UV of the display)
void envAt(FfxFloat32x2 fUv, out FfxFloat32x3 fUpper, out FfxFloat32x3 fLower)
{
    // the images hold a texel for ENV_TEXEL pixels (the tint's for twice that), rounded up: their own UV of a display UV
    const FfxFloat32x2 fSize = FfxFloat32x2(DisplaySize());
    const FfxFloat32x2 fLog  = SampleEnvCurrent(fUv * fSize / FfxFloat32x2(((DisplaySize() + (ENV_TEXEL - 1)) / ENV_TEXEL) * ENV_TEXEL));
    const FfxFloat32x4 fTint = SampleEnvTintCurrent(fUv * fSize / FfxFloat32x2(((DisplaySize() + (2 * ENV_TEXEL - 1)) / (2 * ENV_TEXEL)) * (2 * ENV_TEXEL)));

    fUpper = FfxFloat32x3(fLog.x, fTint.x, fTint.z);
    fLower = FfxFloat32x3(fLog.y, fTint.y, fTint.w);
}

// one number: the gain needed, by its difference in the upper and in the lower envelope
FfxFloat32 envNeeded(FfxFloat32 fByUpper, FfxFloat32 fByLower, FfxFloat32 fMost)
{
    if (fByUpper * fByLower > 0.0f)
    {
        return clamp(abs(fByUpper) < abs(fByLower) ? fByUpper : fByLower, -fMost, fMost);
    }
    return 0.0f;
}

// one sample: how far each of its three gains is believed (0 to 1), and the gains it needed (log), from the envelopes
// at the place it is put and at the place it was fetched
FfxFloat32x3 envBelieved(FfxFloat32x3 fUpperPlace, FfxFloat32x3 fLowerPlace, FfxFloat32x2 fFetchUv, out FfxFloat32x3 fNeeded)
{
    FfxFloat32x3 fUpperFetch;
    FfxFloat32x3 fLowerFetch;
    envAt(fFetchUv, fUpperFetch, fLowerFetch);

    const FfxFloat32x3 fByUpper = fUpperPlace - fUpperFetch;
    const FfxFloat32x3 fByLower = fLowerPlace - fLowerFetch;
    fNeeded = FfxFloat32x3(envNeeded(fByUpper.x, fByLower.x, ENV_GAIN_MOST), envNeeded(fByUpper.y, fByLower.y, ENV_TINT_MOST), envNeeded(fByUpper.z, fByLower.z, ENV_TINT_MOST));

    const FfxFloat32x3 fGap = ffxMax(ffxMax(fUpperPlace - fLowerPlace, fUpperFetch - fLowerFetch), FfxFloat32x3(0.0f, 0.0f, 0.0f));
    return smoothstep(ENV_GATE_0, ENV_GATE_1, abs(fNeeded) / (fGap * ENV_GATE_BY_WIDTH + ENV_GATE_WIDTH));
}

// what a sample's red, green and blue are multiplied by, for its three gains (log): the brightness's on all three, the
// tints' on red and on blue, and on green what keeps a grey's brightness
FfxFloat32x3 envGain(FfxFloat32x3 fGain)
{
    return exp(FfxFloat32x3(fGain.x + fGain.y, fGain.x - (0.2126f * fGain.y + 0.0722f * fGain.z) / 0.7152f, fGain.x + fGain.z));
}

// THE PIXEL: true where a sample was relit; then fEnvT is the current frame's share by the two samples' trust and
// fEnvShare how far the pixel takes it. False: nothing was touched, and the pixel is the product's.
FfxBoolean envRelight(FfxFloat32x2 fUv, FfxFloat32x2 fHalfUv, inout FfxFloat32x3 fPrevRaw, inout FfxFloat32x3 fCurrRaw, out FfxFloat32 fEnvT, out FfxFloat32 fEnvShare)
{
    fEnvT     = 0.5f;
    fEnvShare = 0.0f;

    const FfxFloat32 fGrown = ffxSaturate((FfxFloat32(FrameIndexSinceLastReset()) - ENV_FRAME_0) / (ENV_FRAME_1 - ENV_FRAME_0));
    if (fGrown <= 0.0f || (fHalfUv.x == 0.0f && fHalfUv.y == 0.0f))
    {
        return false;
    }

    FfxFloat32x3 fUpperPlace;
    FfxFloat32x3 fLowerPlace;
    envAt(fUv, fUpperPlace, fLowerPlace);

    FfxFloat32x3 fNeedPrev;
    FfxFloat32x3 fNeedCurr;
    const FfxFloat32x3 fBelievedPrev = envBelieved(fUpperPlace, fLowerPlace, fUv + fHalfUv, fNeedPrev) * fGrown;
    const FfxFloat32x3 fBelievedCurr = envBelieved(fUpperPlace, fLowerPlace, fUv - fHalfUv, fNeedCurr) * fGrown;
    const FfxFloat32x3 fMost = ffxMax(fBelievedPrev, fBelievedCurr);
    fEnvShare = ffxMax(fMost.x, ffxMax(fMost.y, fMost.z));
    if (fEnvShare <= 0.0f)
    {
        return false;
    }

    const FfxFloat32 fPower = BackBufferTransferFunction() == 0 ? 1.0f / ENV_SRGB : 1.0f;
    fPrevRaw *= envGain(fNeedPrev * fBelievedPrev * fPower);
    fCurrRaw *= envGain(fNeedCurr * fBelievedCurr * fPower);

    const FfxFloat32 fTrustPrev = exp(-(abs(fNeedPrev.x) + abs(fNeedPrev.y) + abs(fNeedPrev.z)) / ENV_TRUST);
    const FfxFloat32 fTrustCurr = exp(-(abs(fNeedCurr.x) + abs(fNeedCurr.y) + abs(fNeedCurr.z)) / ENV_TRUST);
    fEnvT = fTrustCurr / (fTrustPrev + fTrustCurr);
    return true;
}

void updateInPaintingWeight(inout FfxFloat32 fInPaintingWeight, FfxFloat32 fFactor)
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation.h
--- old
    // (the mod's cut fi-interpolation-same-vector-once: the same function of the same arguments is not computed twice)
--- new
    // (the variant v-env) the two samples along the game's vector, each relit for the place it is put; where nothing is
    // believed nothing is touched
    FfxFloat32 fEnvT     = 0.5f;
    FfxFloat32 fEnvShare = 0.0f;
    const FfxBoolean bEnv = envRelight(fUvInScreenSpace, gameMv.fMotionVector * fUvLetterBoxScale, fPrevColorGame.fRaw, fCurrColorGame.fRaw, fEnvT, fEnvShare);

    // (the mod's cut fi-interpolation-same-vector-once: the same function of the same arguments is not computed twice)
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation.h
--- old
        fInterpolatedColor = ffxLerp(fPrevColorGame.fRaw, fCurrColorGame.fRaw, ffxSaturate(t));
--- new
        // (the variant v-env) where both samples are used and the pixel is relit, the one that needed the least relighting is believed
        if (bEnv && fDisocclusionFactor.x > 0.0f && fDisocclusionFactor.y > 0.0f)
        {
            t = ffxLerp(t, fEnvT, fEnvShare);
        }
        fInterpolatedColor = ffxLerp(fPrevColorGame.fRaw, fCurrColorGame.fRaw, ffxSaturate(t));
--- end
