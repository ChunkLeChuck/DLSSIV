--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation_disocclusion_mask.h
--- old
    g_hbvWhole = gameMv.fMotionVector * PositionWhole();    // (the variant v-hide-by-vector) the pixel's whole vector
--- new
    g_hbvWhole = gameMv.fMotionVector * PositionWhole();    // (the variant v-hide-by-vector) the pixel's whole vector

    // (the variant v-hide-reach) ONCE A PIXEL THAT MOVES: the thing at the fetch place in the frame before, and the one REACH px above it
    FfxBoolean bStoodThere = false;
    {
        const FfxFloat32x2 fSize   = FfxFloat32x2(RenderSize());
        const FfxFloat32x2 fHerePx = g_hbvWhole * fSize;
        if (dot(fHerePx, fHerePx) > HBV_MIN_PX * HBV_MIN_PX)
        {
            // the three reads are issued together (clamped to the screen), so that none waits for another
            const FfxFloat32x2 fFetchPx = (fDepthUv + gameMv.fMotionVector * PositionToPrevious()) * fSize;
            const FfxInt32x2   iLast    = FfxInt32x2(RenderSize()) - 1;
            const FfxInt32x2   iFetch   = clamp(FfxInt32x2(floor(fFetchPx)), FfxInt32x2(0, 0), iLast);
            const FfxInt32x2   iAbove   = clamp(FfxInt32x2(floor(fFetchPx - FfxFloat32x2(0.0f, REACH))), FfxInt32x2(0, 0), iLast);
            const FfxFloat32x2 fHereMv  = LoadDilatedMotionVector(iFetch) * fSize;
            const FfxFloat32x2 fThereMv = LoadDilatedMotionVector(iAbove) * fSize;
            const FfxFloat32   fThere   = LoadDilatedDepth(iAbove);
            g_hbvStays = IsOnScreen(FfxInt32x2(floor(fFetchPx)), RenderSize()) && hbvStaying(fHereMv);
            const FfxFloat32x2 fWasAt = FfxFloat32x2(iAbove) + 0.5f + fThereMv - fFetchPx;
#if FFX_FRAMEINTERPOLATION_OPTION_INVERTED_DEPTH
            const FfxBoolean bNear = fThere >= fDilatedDepth * (1.0f - REACH_DEPTH);
#else
            const FfxBoolean bNear = fThere <= fDilatedDepth * (1.0f + REACH_DEPTH);
#endif
            bStoodThere = !g_hbvStays && IsOnScreen(FfxInt32x2(floor(fFetchPx - FfxFloat32x2(0.0f, REACH))), RenderSize()) && bNear && dot(fWasAt, fWasAt) < REACH_TOL * REACH_TOL && hbvStaying(fThereMv);
        }
    }
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation_disocclusion_mask.h
--- old
    const FfxFloat32 fDepthClipInterpolatedToPrevious   = 1.0f - ComputeDepthClip(0, fDepthUv + gameMv.fMotionVector * PositionToPrevious(), fDilatedDepth);    // (the mod's cut fi-position)
--- new
    // (the variant v-hide-reach) the bounce: a thing that stays stood at the fetch place, by its own vector: hidden, the test not run
    const FfxFloat32 fDepthClipInterpolatedToPrevious   = bStoodThere ? 0.0f : 1.0f - ComputeDepthClip(0, fDepthUv + gameMv.fMotionVector * PositionToPrevious(), fDilatedDepth);    // (the mod's cut fi-position)
--- end
file framegeneration/fsr3/include/gpu/frameinterpolation/ffx_frameinterpolation_disocclusion_mask.h
--- old
    fDisocclusionMask.y = ffxSaturate(fDisocclusionMask.y + FfxFloat32(!IsOnScreen(iSamplePosCurrent, RenderSize())));

    StoreDisocclusionMask(iPxPos, fDisocclusionMask);
--- new
    fDisocclusionMask.y = ffxSaturate(fDisocclusionMask.y + FfxFloat32(!IsOnScreen(iSamplePosCurrent, RenderSize())));

    // (the variant v-hide-reach) THE MARK: the frame before's sample hidden with a thing that stays at its fetch place (by AMD's test or
    // by this cut's) is written as 1/255, not 0. The interpolation pass reads the mask as hidden all the same (it asks for exactly 1);
    // v-lone-place, where it is built, reads the mark (only there does it weigh a lone sample's light, with no read of its own).
    if (fDisocclusionMask.x == 0.0f && (g_hbvStays || bStoodThere))
    {
        fDisocclusionMask.x = 1.0f / 255.0f;
    }

    StoreDisocclusionMask(iPxPos, fDisocclusionMask);
--- end
