file framegeneration/fsr3/internal/ffx_frameinterpolation.cpp
--- old
    // copy resources to uavResrouces list
--- new
    // (the variant v-ghost) the two images of the real frames' broad colour: an eighth of the display (a block of the
    // optical flow's grid a texel). The optical flow field's pass writes the "current" one whole in every dispatch that
    // interpolates; ffxFrameInterpolationDispatch makes the two change places first
    {
        const uint32_t ghostLowIds[2] = {FFX_FRAMEINTERPOLATION_RESOURCE_IDENTIFIER_RESERVED_2, FFX_FRAMEINTERPOLATION_RESOURCE_IDENTIFIER_RESERVED_3};
        const wchar_t* ghostLowNames[2] = {L"FI_GhostLowPrevious", L"FI_GhostLowCurrent"};
        for (int i = 0; i < 2; ++i)
        {
            FfxCreateResourceDescription ghostLow = { FfxResourceHeapPlacementInfo::InitDefault(), { FFX_API_RESOURCE_TYPE_TEXTURE2D, FFX_API_SURFACE_FORMAT_R16G16B16A16_FLOAT, (contextDescription->displaySize.width + 7) / 8, (contextDescription->displaySize.height + 7) / 8, 1, 1, FFX_API_RESOURCE_FLAGS_NONE, FFX_API_RESOURCE_USAGE_UAV }, FFX_API_RESOURCE_STATE_UNORDERED_ACCESS, ghostLowNames[i], ghostLowIds[i], {FFX_RESOURCE_INIT_DATA_TYPE_UNINITIALIZED} };
            FFX_VALIDATE(context->contextDescription.backendInterface.fpCreateResource(&context->contextDescription.backendInterface, &ghostLow, context->effectContextId, &context->srvResources[ghostLowIds[i]]));
        }
    }

    // copy resources to uavResrouces list
